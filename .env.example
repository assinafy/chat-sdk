# Assinafy API credentials
# Sandbox: https://sandbox.assinafy.com.br/v1
# Production: https://api.assinafy.com.br/v1
ASSINAFY_BASE_URL=https://sandbox.assinafy.com.br/v1
ASSINAFY_API_KEY=
ASSINAFY_ACCOUNT_ID=

# Optional emails used by the integration test suite
ASSINAFY_TEST_EMAIL_PRIMARY=
ASSINAFY_TEST_EMAIL_SECONDARY=
# Set to 1 only for intentional notifications: sandbox signing or production contract renewal.
ASSINAFY_TEST_NOTIFICATIONS=0

# Separate opt-in production lifecycle suite; creates and removes disposable resources.
# Run tests/integration/production.live.test.ts explicitly with the gate set to 1.
# Contract renewal also requires ASSINAFY_TEST_NOTIFICATIONS=1 and may email the owner.
ASSINAFY_TEST_PRODUCTION=0
ASSINAFY_PRODUCTION_API_KEY=
ASSINAFY_PRODUCTION_ACCOUNT_ID=
